{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZQP Quiz-Generator",
  "version": "0.2.4",
  "identifier": "de.zqp.quizgenerator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ZQP Quiz-Generator",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBOURBRDFDNzlBN0UyRTEKUldUaDRxZDVISzJkcXFTRzZxcUptRU5EaTJzN2w3NEdMUXlTdUNxZWh1dDA5NVRJR2NwT3I2RXcK",
      "endpoints": [
        "https://github.com/ZQP/quiz-generator/releases/latest/download/latest.json"
      ]
    }
  }
}

